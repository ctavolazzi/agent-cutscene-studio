   "link": null,
   "locked": false,
   "text": "Numbered circles are cameras. Solid wedge: field of view at the shot\nstart, reaching the subject. Dashed wedge: at the shot end.\nArrow: camera move. North is up.\nWind blows from the east-north-east toward the street side.",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Numbered circles are cameras. Solid wedge: field of view at the shot\nstart, reaching the subject. Dashed wedge: at the shot end.\nArrow: camera move. North is up.\nWind blows from the east-north-east toward the street side.",
   "autoResize": true,
   "lineHeight": 1.25
  },
